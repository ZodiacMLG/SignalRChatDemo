        <TextBlock x:Name="chatText" Width="400" Height="280" />
        <TextBox x:Name="inputText" Width="400" Height="60" />
        <Button x:Name="buttonChangeText" Click="btn_clickOnClick"/>
    </StackPanel>-->
</Window>
