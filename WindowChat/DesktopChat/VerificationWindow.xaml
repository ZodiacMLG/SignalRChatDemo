<Window x:Class="DesktopChat.VerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopChat"
        mc:Ignorable="d"
        Title="VerificationWindow" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0">Введите никнейм:</TextBlock>
        <TextBox Name="nameBox" Grid.Row="1" MinWidth="250"></TextBox>
        <!--<TextBlock Grid.Row="2">Введите пароль:</TextBlock>
        <TextBox Name="passwordBox" Grid.Row="3" MinWidth="250">Пароль</TextBox>-->

        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,35,0,0">
            <Button IsDefault="True" Click="Accept_Click" MinWidth="60" Margin="0,0,10,0">OK</Button>
            <Button IsCancel="True" MinWidth="60">Отмена</Button>
        </WrapPanel>

    </Grid>
</Window>
